# LeadIQ Backend Environment Variables

# Primary Database Connection (Supabase PostgreSQL / Cloud DB)
# Note: If your password contains special characters like '@', URL-encode it (e.g. '@' -> '%40')
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_project.supabase.co:5432/postgres

# Alternatively, traditional MySQL / Postgres host configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=leadiq_db

# Fallback to local SQLite if remote server is unavailable during local development/testing
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=./leadiq.db

# JWT Security
JWT_SECRET_KEY=leadiq_secret_key_change_in_production_983742189741
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS
APP_ENV=development
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
